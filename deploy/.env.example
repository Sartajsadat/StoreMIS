# Store MIS production settings. Copy to .env (scripts/install.sh or install.ps1 creates it with random secrets).
# Keep this file private: it holds the database password and the token signing key.

# Database
DB_NAME=storemis
DB_USER=storemis
DB_PASSWORD=change-me-to-a-long-random-password

# Token signing key: at least 32 random characters.
JWT_SECRET=change-me-to-at-least-32-random-characters-xxxxxxxx

# First administrator (only used while the database has no users). Must be changed at first sign-in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe2026

# Port the shop PCs use: http://<server-ip>:HTTP_PORT/ (80 = no port in the address).
HTTP_PORT=80

# true only if the app is served over HTTPS.
COOKIE_SECURE=false

# Backups: folder on the server, daily time (cron format, Kabul time) and how many copies to keep.
BACKUP_DIR=./backups
BACKUP_CRON=30 21 * * *
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12
# Optional second copy (USB disk or network share), e.g. /media/usb/storemis or E:/StoreMIS-backups
EXTERNAL_BACKUP_DIR=./backups-external

# Java memory: share of the server's RAM the backend may use.
JAVA_OPTS=-XX:MaxRAMPercentage=60 -XX:+ExitOnOutOfMemoryError
